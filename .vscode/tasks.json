{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Android App",
            "type": "shell",
            "command": "gradle",
            "args": [":app:assembleDebug"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": ["$javac"],
            "presentation": {
                "reveal": "always"
            }
        }
    ]
}
